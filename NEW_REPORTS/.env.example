# GT IBKR Flex Web Service
GT_FLEX_TOKEN=your_flex_web_service_token_here
GT_FLEX_QUERY_ID=your_flex_query_id_here

# TWS / IB Gateway (EC2): 7496 live TWS | 7497 paper TWS | 4001 live Gateway | 4002 paper Gateway
TWS_HOST=127.0.0.1
TWS_PORT=7496
TWS_CLIENT_ID=997
USE_TWS=1

# Dashboard risk limits (your own settings, not from IBKR)
MAX_EXPOSURE=150000
DAILY_MAX_LOSS=2000
LOSS_DUE_TO_BUGS=0
